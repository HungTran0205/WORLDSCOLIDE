# DevOps Skill - Environment Variables
#
# SECURITY: Never commit this file to version control.
# Use different credentials per environment (dev/staging/prod).
# Rotate credentials regularly. Follow least-privilege principle.

# =============================================================================
# AWS Configuration
# =============================================================================

# Option 1: IAM User access keys (development only - NOT recommended for production)
# Generate from: IAM Console -> Users -> Security credentials -> Create access key
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Option 2: SSO / IAM Identity Center (recommended for developers)
# Configure with: aws configure sso
# AWS_PROFILE=your-sso-profile

# Option 3: Assume Role (recommended for CI/CD and cross-account)
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/DeployRole

# Account & Region
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1
# AWS_DEFAULT_REGION=us-east-1

# =============================================================================
# Amazon ECR (Elastic Container Registry)
# =============================================================================
# Registry URL is derived from account ID and region:
# ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
# ECR_REPOSITORY=my-app

# =============================================================================
# Docker Configuration
# =============================================================================
# Optional: Docker Hub authentication (for pulling base images)
# DOCKER_USERNAME=your_docker_username
# DOCKER_PASSWORD=your_docker_password

# =============================================================================
# CI/CD Configuration
# =============================================================================
# GitHub Actions (prefer OIDC over stored tokens)
# GITHUB_TOKEN=your_github_token

# =============================================================================
# Monitoring & Logging
# =============================================================================
# Optional: External observability tools

# Sentry
# SENTRY_DSN=your_sentry_dsn

# Datadog
# DD_API_KEY=your_datadog_api_key
