# Memgraph Connection Settings
MEMGRAPH_HOST=localhost
MEMGRAPH_PORT=7687
MEMGRAPH_HTTP_PORT=7444

# Query Execution Settings
QUERY_TIMEOUT=30
MAX_RESULTS=1000
MEMGRAPH_BATCH_SIZE=1000

# Model Provider for Natural Language to Cypher (optional - uses code-graph-rag settings)
# CYPHER_PROVIDER=ollama
# CYPHER_MODEL=codellama
# CYPHER_ENDPOINT=http://localhost:11434/v1
# CYPHER_API_KEY=

# Repository Path (optional)
TARGET_REPO_PATH=.
